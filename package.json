{
  "name": "unity-project-exporter",
  "version": "1.0.0",
  "description": "Exportador de proyectos Unity a ZIP",
  "author": "StormGamesStudios <meliodas.aitor@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acierto-incomodo/UnityProjectExporter.git"
  },
  "build": {
    "appId": "com.stormgamesstudios.unityexporter",
    "productName": "Unity Project Exporter",
    "copyright": "Copyright © 2026 StormGamesStudios",
    "publish": [
      {
        "provider": "github",
        "owner": "acierto-incomodo",
        "repo": "UnityProjectExporter"
      }
    ],
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/install.nsh",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}