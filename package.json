{
  "name": "unity-project-exporter",
  "version": "1.0.0",
  "description": "Exportador de proyectos Unity a ZIP",
  "author": "StormGamesStudios <meliodas.aitor@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "dist": "npm run dist:clean && electron-builder -wl",
    "dist:win": "npm run dist:clean && electron-builder --win",
    "dist:linux": "npm run dist:clean && electron-builder --linux"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acierto-incomodo/UnityProjectExporter.git"
  },
  "build": {
    "appId": "com.stormgamesstudios.unityexporter",
    "productName": "Unity Project Exporter",
    "copyright": "Copyright © 2026 StormGamesStudios",
    "publish": [
      {
        "provider": "github",
        "owner": "acierto-incomodo",
        "repo": "UnityProjectExporter"
      }
    ],
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web, nsis, zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Unity-Project-Exporter_${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/install.nsh",
      "artifactName": "Unity-Project-Exporter_${version}_SetupOffline.${ext}"
    },
    "nsisWeb": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/install.nsh",
      "artifactName": "Unity-Project-Exporter_${version}_Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "zip"
      ],
      "category": "Development",
      "artifactName": "Unity-Project-Exporter_${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}